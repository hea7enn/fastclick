.welcome {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  padding: 64rpx 48rpx;
  text-align: center;
}

.welcome-title {
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.welcome-desc {
  font-size: 28rpx;
  opacity: 0.95;
  margin-bottom: 48rpx;
  line-height: 1.8;
}

.welcome-actions {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.welcome-actions button {
  background-color: #FFFFFF;
  color: #667eea;
}

.welcome-actions .btn-secondary {
  background-color: transparent;
  color: #FFFFFF;
  border-color: #FFFFFF;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
  background-color: #F9FAFB;
  border-radius: 16rpx;
}

.stats-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #4F46E5;
  margin-bottom: 12rpx;
}

.stats-label {
  font-size: 26rpx;
  color: #6B7280;
}

.features {
  display: flex;
  flex-direction: column;
}

.feature-item {
  padding: 32rpx;
  margin-bottom: 16rpx;
  background-color: #F9FAFB;
  border-radius: 16rpx;
  border-left: 8rpx solid #4F46E5;
}

.feature-item:last-child {
  margin-bottom: 0;
}

.feature-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 12rpx;
}

.feature-desc {
  font-size: 26rpx;
  color: #6B7280;
}
