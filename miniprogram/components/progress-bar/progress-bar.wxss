.progress-bar {
  padding: 24rpx 0;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-label {
  font-size: 28rpx;
  color: #6B7280;
}

.progress-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #4F46E5;
}

.progress-track {
  width: 100%;
  height: 16rpx;
  background-color: #E5E7EB;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4F46E5 0%, #6366F1 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}
